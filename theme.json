{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "yellow",
          "name": "BEXSTAR Yellow",
          "color": "#FFC400"
        },
        {
          "slug": "navy",
          "name": "Deep Navy",
          "color": "#071E33"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "light",
          "name": "Light Gray",
          "color": "#F5F7F8"
        },
        {
          "slug": "muted",
          "name": "Text Gray",
          "color": "#5F6B76"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System sans",
          "fontFamily": "Arial, Helvetica, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1.125rem"
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "1.375rem"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.5rem",
            "max": "5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Medium",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "Large",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "3rem"
        },
        {
          "slug": "70",
          "name": "Section",
          "size": "clamp(3rem, 6vw, 6rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|navy"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 4vw, 4rem)",
        "right": "clamp(1rem, 4vw, 4rem)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.12",
          "letterSpacing": "-0.03em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|heading"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "1.5rem"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|navy"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|yellow",
          "text": "var:preset|color|navy"
        },
        "border": {
          "radius": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "700"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Global header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Enterprise footer",
      "area": "footer"
    }
  ]
}
